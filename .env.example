# Copy to .env and fill in. `npm start` and `npm run check` load .env automatically.

# Required
GEMINI_API_KEY=
# Comma-separated hosts videos may be fetched from (exact host or its subdomains)
ALLOWED_VIDEO_HOSTS=uploads.example.com
# Comma-separated hosts webhook callbacks may be sent to (empty = callbacks disabled)
ALLOWED_CALLBACK_HOSTS=

# Optional
PORT=8080
# Job logs are also appended here (empty = stdout only)
LOG_FILE=logs/reelcheck.log
# Shorter video edge in px; CDN copies are re-encoded (e.g. 576x1024)
MIN_SHORT_EDGE_PX=540
GEMINI_MODEL=gemini-3.1-flash-lite
# Used for the last attempt when the main model is overloaded (empty = no fallback)
GEMINI_FALLBACK_MODEL=
# Per-call timeout and attempts; Flash-Lite can return 503 or stall under load
GEMINI_ATTEMPTS=3
GEMINI_ATTEMPT_TIMEOUT_MS=35000
GEMINI_THINKING_LEVEL=minimal
GEMINI_SEND_AUDIO=0
# USD per 1M tokens; confirm against Google's current pricing
GEMINI_PRICE_INPUT_PER_M=0.1
GEMINI_PRICE_AUDIO_INPUT_PER_M=0.3
GEMINI_PRICE_OUTPUT_PER_M=0.4
CONTENT_FLAGS_REVIEW=unsafe
# Checks per client IP per hour; TRUST_PROXY=1 to use X-Forwarded-For behind a proxy
RATE_LIMIT_PER_HOUR=60
TRUST_PROXY=0
